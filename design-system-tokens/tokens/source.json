{
  "meta": {
    "name": "Portfolio Design Tokens",
    "version": "1.0.0",
    "fontFamily": "\"SF Pro Text\", \"SF Pro Display\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif"
  },
  "typography": {
    "heading-1": { "size": 40, "weight": 500, "lineHeight": 48 },
    "heading-2": { "size": 28, "weight": 500, "lineHeight": 36 },
    "heading-3": { "size": 20, "weight": 500, "lineHeight": 28 },
    "subtitle": { "size": 18, "weight": 400, "lineHeight": 28 },
    "subtitle-2": { "size": 16, "weight": 500, "lineHeight": 27 },
    "button": { "size": 15, "weight": 500, "lineHeight": 18 },
    "body-large": { "size": 18, "weight": 400, "lineHeight": 30 },
    "body-medium": { "size": 16, "weight": 400, "lineHeight": 27 },
    "body-small": { "size": 14, "weight": 400, "lineHeight": 20 },
    "caption": { "size": 12, "weight": 400, "lineHeight": 16 }
  },
  "spacing": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "6": 24,
    "8": 32,
    "9": 36,
    "10": 40,
    "12": 48,
    "20": 80,
    "25": 100,
    "32": 128,
    "page-top": 158
  },
  "radius": {
    "xs": 2,
    "sm": 4,
    "md": 8,
    "lg": 12,
    "xl": 24,
    "full": 9999
  },
  "motion": {
    "ease": {
      "smooth": "cubic-bezier(0.22, 1, 0.36, 1)"
    },
    "duration": {
      "fast": 150,
      "normal": 200,
      "slow": 300
    },
    "semantic": {
      "fade": { "duration": "slow", "ease": "smooth" },
      "theme": { "duration": "slow", "ease": "smooth" }
    }
  },
  "color": {
    "primitive": {
      "gray": {
        "0": "#ffffff",
        "50": "#fafafa",
        "100": "#f4f4f5",
        "200": "#e4e4e7",
        "400": "#a1a1aa",
        "500": "#71717a",
        "700": "#3f3f46",
        "800": "#27272a",
        "900": "#18181b"
      },
      "blue": {
        "50": "#eff6ff",
        "100": "#dbeafe",
        "200": "#bfdbfe",
        "400": "#60a5fa",
        "500": "#3b82f6",
        "700": "#1d4ed8",
        "900": "#1e3a8a"
      },
      "green": {
        "50": "#f0fdf4",
        "100": "#dcfce7",
        "200": "#bbf7d0",
        "400": "#4ade80",
        "500": "#22c55e",
        "700": "#15803d",
        "900": "#14532d"
      },
      "amber": {
        "50": "#fffbeb",
        "100": "#fef3c7",
        "200": "#fde68a",
        "400": "#fbbf24",
        "500": "#f59e0b",
        "700": "#b45309",
        "900": "#78350f"
      },
      "red": {
        "50": "#fef2f2",
        "100": "#fee2e2",
        "200": "#fecaca",
        "400": "#f87171",
        "500": "#ef4444",
        "700": "#b91c1c",
        "900": "#7f1d1d"
      }
    },
    "semantic": {
      "light": {
        "border": { "primary": "gray-200", "secondary": "gray-100" },
        "content": {
          "primary": "gray-900",
          "secondary": "gray-500",
          "tertiary": "gray-400",
          "contrast": "gray-50"
        },
        "background": {
          "primary": "gray-50",
          "secondary": "gray-100",
          "contrast": "gray-0"
        },
        "surface": {
          "card": { "primary": "gray-50", "secondary": "gray-100" }
        },
        "status": { "positive": "green-500", "warning": "amber-500" },
        "button": {
          "secondary": {
            "default": "gray-100",
            "hover": "gray-200",
            "pressed": "gray-200"
          }
        }
      },
      "dark": {
        "border": { "primary": "gray-700", "secondary": "gray-700" },
        "content": {
          "primary": "gray-50",
          "secondary": "gray-400",
          "tertiary": "gray-500",
          "contrast": "gray-900"
        },
        "background": {
          "primary": "gray-900",
          "secondary": "gray-700",
          "contrast": "gray-900"
        },
        "surface": {
          "card": { "primary": "gray-900", "secondary": "gray-700" }
        },
        "status": { "positive": "green-500", "warning": "amber-500" },
        "button": {
          "secondary": {
            "default": "gray-800",
            "hover": "gray-700",
            "pressed": "gray-700"
          }
        }
      }
    }
  }
}
